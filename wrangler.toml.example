name = "d2r-dclone-notifier"
main = "src/index.js"
compatibility_date = "2026-06-12"

[triggers]
crons = ["* * * * *"]

[[kv_namespaces]]
binding = "DCLONE_STATE"
id = "REPLACE_WITH_YOUR_KV_NAMESPACE_ID"

[vars]
API_URL = "https://d2runewizard.com/api/trackers/diablo-clone"
TERROR_ZONE_API_URL = "https://d2runewizard.com/api/trackers/terror-zone"
BASE_VERSION_NAME = "毁灭之王"
TIME_ZONE = "Asia/Shanghai"
NOTIFY_ON_FIRST_RUN = "false"
